# ELITEX HACKATHON 2026 — Environment Configuration Template
PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# ==============================================================================
# Neon PostgreSQL Configuration
# Choose EITHER Option 1 (DATABASE_URL) OR Option 2 (Individual PG* Variables):
# ==============================================================================

# Option 1: Direct Neon Connection String (Recommended)
# Format: postgresql://<user>:<password>@<neon-hostname>/<dbname>?sslmode=require
DATABASE_URL=

# Option 2: Individual PostgreSQL Connection Variables
PGHOST=<neon-hostname>
PGDATABASE=neondb
PGUSER=<user>
PGPASSWORD=<password>
PGPORT=5432
PGSSLMODE=require
