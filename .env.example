# ELITEX HACKATHON 2026 — Environment Configuration Template
PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# Neon PostgreSQL Database Connection URL
# Replace with your actual Neon PostgreSQL connection string:
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://<user>:<password>@<neon-hostname>/<dbname>?sslmode=require
